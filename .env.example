# Copy this file to .env and fill in the values from your Firebase project:
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — only needed if you want Firebase Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# Powers the real AI chat (netlify/functions/chat.ts). Get a key at
# https://console.anthropic.com -> API Keys. Deliberately NOT prefixed with
# VITE_ — that prefix tells Vite to bundle a variable into the public client
# JS, which would leak it to every visitor. This one must stay server-side
# only, read by the Netlify Function at request time.
ANTHROPIC_API_KEY=
# Optional overrides — defaults are claude-opus-5 at "low" effort (fast,
# cost-conscious replies well suited to a kids' chat). Raise effort toward
# "medium"/"high" if you want more careful reasoning and don't mind the
# extra latency/cost.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
